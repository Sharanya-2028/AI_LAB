
import random

N = 8

# Calculate the number of attacking queen pairs
def heuristic(board):
    conflicts = 0

    for i in range(N):
        for j in range(i + 1, N):

            # Check diagonal conflicts
            if abs(board[i] - board[j]) == abs(i - j):
                conflicts += 1

    return conflicts


# Generate a random board
def random_board():
    return [random.randint(0, N - 1) for _ in range(N)]


# Hill Climbing Algorithm
def hill_climbing():

    board = random_board()

    while True:

        current_h = heuristic(board)

        if current_h == 0:
            return board

        best_board = board[:]
        best_h = current_h

        # Move each queen to another row in its column
        for col in range(N):
            for row in range(N):

                if row != board[col]:

                    new_board = board[:]
                    new_board[col] = row

                    h = heuristic(new_board)

                    if h < best_h:
                        best_h = h
                        best_board = new_board

        # Stop if no better neighbour exists
        if best_h >= current_h:
            return None

        board = best_board


# Display chessboard
def display(board):

    for row in range(N):
        for col in range(N):

            if board[col] == row:
                print("Q", end=" ")
            else:
                print(".", end=" ")

        print()


# Main program with random restart
solution = None

while solution is None:
    solution = hill_climbing()

print("Solution Found:")
display(solution)

print("Number of conflicts:", heuristic(solution))
