
# Verification of Propositional Entailment

def PL_TRUE_KB(model):

    P = model['P']
    Q = model['Q']
    R = model['R']

    s1 = (not Q) or P
    s2 = (not P) or (not Q)
    s3 = Q or R

    return s1 and s2 and s3


def PL_TRUE_QUERY(query, model):

    P = model['P']
    Q = model['Q']
    R = model['R']

    if query == "R":
        return R

    elif query == "R -> P":
        return (not R) or P

    elif query == "Q -> R":
        return (not Q) or R


# Verification Algorithm
def VERIFY_ENTAILMENT(query):

    for P in [True, False]:
        for Q in [True, False]:
            for R in [True, False]:

                model = {'P': P, 'Q': Q, 'R': R}

                if PL_TRUE_KB(model):

                    if not PL_TRUE_QUERY(query, model):
                        return False

    return True


# Display Truth Table
def value(x):
    return 'T' if x else 'F'


print("TRUTH TABLE")
print("-----------------------------------------------")
print("P Q R | Q->P | P->~Q | Q V R | KB")
print("-----------------------------------------------")

for P in [True, False]:
    for Q in [True, False]:
        for R in [True, False]:

            model = {'P': P, 'Q': Q, 'R': R}

            s1 = (not Q) or P
            s2 = (not P) or (not Q)
            s3 = Q or R

            KB = PL_TRUE_KB(model)

            print(value(P), value(Q), value(R), "|",
                  value(s1), "  |",
                  value(s2), "   |",
                  value(s3), "  |",
                  value(KB))

print("-----------------------------------------------")


# Verify all queries
queries = ["R", "R -> P", "Q -> R"]

print("\nVERIFICATION RESULTS")
print("-----------------------------------------------")

for query in queries:

    result = VERIFY_ENTAILMENT(query)

    print("KB entails", query, ":",
          "TRUE" if result else "FALSE")

print("-----------------------------------------------")
